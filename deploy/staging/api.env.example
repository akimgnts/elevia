# Copy to deploy/staging/api.env before running docker compose.
# Do not commit the real file.

# Optional now, but required for LLM-backed features.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Safe defaults for private staging.
ENV=staging
DEBUG=0
ELEVIA_DEV=0
ELEVIA_DEV_TOOLS=0
ELEVIA_INBOX_USE_VIE_FIXTURES=1
ELEVIA_INBOX_FAIL_OPEN=1
ELEVIA_EMBEDDINGS_LOCAL=0

# Optional integrations for later sync/scraping jobs.
ONET_API_KEY=
ONET_API_BASE_URL=

# Business France ScrapeGraphAI fallback (only used when the Civiweb API
# scraper fails — see docs/ai/DECISIONS.md R32). Reuses OPENAI_API_KEY above.
SCRAPEGRAPH_LLM_MODEL=openai/gpt-4o-mini
# Override only if the isolated venv is not at the default Docker path.
# SCRAPEGRAPH_VENV_PYTHON=/opt/scrape-fallback-venv/bin/python
